{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["chrome", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/shared-kernel/*": ["src/shared-kernel/*"],
      "@/domain/*": ["src/domain/*"],
      "@/application/*": ["src/application/*"],
      "@/infrastructure/*": ["src/infrastructure/*"],
      "@/surfaces/*": ["src/surfaces/*"],
      "@/roots/*": ["src/roots/*"],
      "@/testing/*": ["ops/tests/*"]
    }
  },
  "//": "include REPLACES the extended .wxt/tsconfig.json include — .wxt/**/*.d.ts MUST stay listed or WXT ambient types (defineBackground et al.) silently vanish (audit P0-4).",
  "include": ["src/**/*", "entrypoints/**/*", "ops/tests/**/*", "tools/**/*", ".wxt/**/*.d.ts"]
}
